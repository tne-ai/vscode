{
  // Force built-in TypeScript/TSX formatter for this workspace
  "editor.formatOnSave": true,
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  // Avoid Prettier being chosen by default
  "editor.defaultFormatter": null
}
